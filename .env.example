# Production uses a dedicated Postgres connection and Supabase identity.
# pnpm dev generates local secrets in .kff; do not commit them.
KFF_AUTH_MODE=local
KFF_APP_ORIGIN=http://127.0.0.1:3000
# DATABASE_URL=postgresql://...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=...
# KFF_FACEBOOK_GRAPH_VERSION=vXX.X
# KFF_ENABLE_LIVE=false
# KFF_ENABLE_DISCOVERY=false
# APIFY_API_TOKEN=...
# APIFY_USER_ID=...
# Local connection: node --import tsx scripts/apify-connect.ts your-email@example.com
# Apify comments: DATA_PROVIDER + COMMENTS + target apify-run:<successful-run-id>
# FACEBOOK_PAGE_TOKEN=...
# Signed Page webhook ingress; do not reuse the Page access token here.
# KFF_FACEBOOK_APP_SECRET=...
# KFF_FACEBOOK_VERIFY_TOKEN=...
# KFF_FACEBOOK_EVENTS_PER_MINUTE=1000
# Optional model endpoint; LOCAL_RULES works without any external model.
# KFF_RECEPTION_AI_URL=https://api.openai.com/v1/chat/completions
# KFF_RECEPTION_AI_KEY=...
# KFF_RECEPTION_AI_MODEL=...
# Additional local Agent pairing file; each identity retains an independent journal.
# KFF_AGENT_CONFIG_FILE=.kff/pairings/second-agent.json
# Local browser environment: only the Agent and its browser guardian receive these.
# KFF_ADSPOWER_ORIGIN=http://127.0.0.1:50325
# KFF_ADSPOWER_API_KEY=...
# Native profiles may reference a local proxy JSON object. AdsPower owns its own proxy settings.
# KFF_BROWSER_PROXY_US01={"server":"http://127.0.0.1:8080"}
