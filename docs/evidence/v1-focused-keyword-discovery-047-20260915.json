      "fields": {
        "message": {
          "kind": "VALUE",
          "value": "Most Feng Shui advice online starts too far downstream.\nPeople jump straight to wealth corners, lucky colors, cures, or furniture placement before establishing the one thing that changes how the whole space is read: orientation.\nThat is why two homes that look almost identical can still need very different recommendations.\nBefore interpreting any sector of a property, you need the map first.\nAnd in Feng Shui, direction is part of that map.\n#FengShui #FengShuiTips #FengShuiPhilippines #ChineseMetaphysics #FengShuiGo"
        },
        "author_id": {
          "kind": "NOT_RETURNED"
