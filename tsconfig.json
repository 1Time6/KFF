{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "@kff/contracts": ["packages/contracts/src/index.ts"],
      "@kff/core": ["packages/core/src/index.ts"],
      "@kff/core/*": ["packages/core/src/*"],
      "@kff/database": ["packages/database/src/index.ts"],
      "@kff/database/*": ["packages/database/src/*"],
      "@kff/adapters": ["packages/adapters/src/index.ts"]
    },
    "plugins": [{"name": "next"}]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", ".kff", "**/.next", "**/.next-production"]
}
